# ==============================================================================
# JimoTable Community Free Edition Environment Configuration
# ==============================================================================

# Core Image & Tag
JIMOTABLE_IMAGE=ghcr.io/jimotable/jimotable
JIMOTABLE_VERSION=0.2.1
# PostgreSQL 18 image for new Free/online installations; not a PG16 data upgrade.
JIMOTABLE_POSTGRES_IMAGE=postgres:18.6-alpine

# HTTP Service Port (Defaults to 8080 on host)
JIMOTABLE_HTTP_PORT=8080
JIMOTABLE_PUBLIC_BASE_URL=http://127.0.0.1:8080

# Free image: one tenant per installation. Values below may lower caps, never raise the built-in ceilings.
JIMOTABLE_QUOTA_BASE_LIMIT=2
JIMOTABLE_QUOTA_TABLES_PER_BASE_LIMIT=20
JIMOTABLE_QUOTA_RECORD_LIMIT=2000000
JIMOTABLE_QUOTA_RECORDS_PER_TABLE_LIMIT=100000
JIMOTABLE_QUOTA_FIELDS_PER_TABLE_LIMIT=30
JIMOTABLE_QUOTA_ATTACHMENT_BYTES_LIMIT=1073741824
JIMOTABLE_QUOTA_AI_CONCURRENCY_LIMIT=4

# Optional HTTPS URL of the official stable release manifest; checked only on user action.
JIMOTABLE_UPDATE_MANIFEST_URL=
